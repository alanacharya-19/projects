{
  "expo": {
    "name": "CineFlow",
    "slug": "cineflow",
    "version": "1.0.0",
    "orientation": "all",
    "icon": "./assets/icon/app_icon.png",
    "scheme": "cineflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow CineFlow to access your photos to play videos.",
        "NSPhotoLibraryAddUsageDescription": "Allow CineFlow to save videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon/app_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.alanacharya1.videoplayer",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon/app_icon.png"
    },
    "plugins": [
      "expo-screen-orientation",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/app_icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow CineFlow to access your photos to play videos.",
          "savePhotosPermission": "Allow CineFlow to save videos."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e0567ec-92e7-4e3d-b127-2e07a8a0452b"
      }
    }
  }
}